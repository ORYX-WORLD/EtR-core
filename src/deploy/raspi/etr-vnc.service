[Unit]
Description=EtR local VNC source for the 1280x720 remote desktop
After=etr-remote-desktop.service
Wants=etr-remote-desktop.service

[Service]
Type=simple
Environment=DISPLAY=:2
Environment=XAUTHORITY=/home/oryx/.Xauthority
ExecStart=/usr/bin/x11vnc -display :2 -auth /home/oryx/.Xauthority -localhost -forever -shared -nopw -rfbport 5901 -noxdamage
Restart=always
RestartSec=3
User=oryx
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
