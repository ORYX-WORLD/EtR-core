[Unit]
Description=EtR local VNC screen source
After=spi-desktop.service
Requires=spi-desktop.service

[Service]
Type=simple
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/oryx/.Xauthority
ExecStart=/usr/bin/x11vnc -display :1 -auth /home/oryx/.Xauthority -localhost -forever -shared -nopw -rfbport 5901 -noxdamage
Restart=always
RestartSec=3
User=oryx
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
