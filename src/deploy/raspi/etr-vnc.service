[Unit]
Description=EtR VNC source for the physical SPI framebuffer
After=spi-desktop.service
Requires=spi-desktop.service

[Service]
Type=simple
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/oryx/.Xauthority
ExecStartPre=+/usr/bin/bash /home/oryx/EtR-core/src/deploy/raspi/etr-recover-github-runner.sh
ExecStart=/usr/local/bin/etr-vnc-rawfb.sh
Restart=always
RestartSec=3
User=oryx
SupplementaryGroups=video
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
