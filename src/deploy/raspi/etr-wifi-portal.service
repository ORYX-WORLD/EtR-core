[Unit]
Description=EtR Wi-Fi onboarding portal and local touch controls
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/oryx/EtR-core
# Le répertoire est partagé avec l'acquisition non privilégiée. Ne pas utiliser
# StateDirectory ici : avec User=root, systemd le réattribuerait à root et
# empêcherait oryx d'écrire telemetry.json.
ExecStartPre=/usr/bin/install -d -m 700 -o oryx -g oryx /var/lib/etr-core
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/oryx/EtR-core/.venv/bin/python /home/oryx/EtR-core/src/touch_shell.py
Restart=always
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/etr-core /etc/NetworkManager/system-connections

[Install]
WantedBy=multi-user.target
