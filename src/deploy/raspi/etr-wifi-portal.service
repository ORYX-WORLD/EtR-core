[Unit]
Description=EtR Wi-Fi onboarding portal and local touch controls
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/oryx/EtR-core
StateDirectory=etr-core
StateDirectoryMode=0755
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/oryx/EtR-core/.venv/bin/python /home/oryx/EtR-core/src/touch_shell.py
Restart=always
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/etr-core /etc/NetworkManager/system-connections

[Install]
WantedBy=multi-user.target
