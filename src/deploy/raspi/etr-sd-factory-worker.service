[Unit]
Description=Moteur persistant de fabrication microSD EtR
After=local-fs.target network-online.target
Wants=network-online.target
Conflicts=etr-sd-recovery.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/oryx/EtR-core
ExecStart=/home/oryx/EtR-core/.venv/bin/python /home/oryx/EtR-core/src/deploy/raspi/etr_sd_factory_worker.py
ExecStopPost=/usr/local/bin/etr-sd-factory-cleanup
TimeoutStartSec=infinity
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=mixed
UMask=0077
RuntimeDirectory=etr-sd-factory
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/etr-core /run/etr-sd-factory /run/lock /dev
PrivateDevices=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
