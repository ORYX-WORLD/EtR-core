[Unit]
Description=EtR secure outbound remote screen
After=network-online.target etr-vnc.service
Wants=network-online.target etr-vnc.service

[Service]
Type=simple
EnvironmentFile=-/etc/etr-core/firebase-bridge.env
Environment=ETR_LOCAL_VNC_PORT=5901
Environment=ETR_TOKEN_FILE=/var/lib/etr-core/remote-screen-auth.json
WorkingDirectory=/home/oryx/EtR-core/src
ExecStart=/home/oryx/EtR-core/.venv/bin/python /home/oryx/EtR-core/src/remote_screen_agent.py
Restart=always
RestartSec=5
User=oryx
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/etr-core
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
