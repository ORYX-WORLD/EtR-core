[Unit]
Description=EtR acquisition according to selected hardware
Wants=etr.service
Before=etr.service
After=local-fs.target systemd-udev-settle.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=oryx
Group=oryx
WorkingDirectory=/var/lib/etr-core
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Le portail Wi-Fi tourne sous root et ne doit jamais retirer l'écriture à oryx.
# Cette préparation idempotente rétablit les droits avant chaque démarrage.
ExecStartPre=+/usr/bin/install -d -m 700 -o oryx -g oryx /var/lib/etr-core
# Le processus prépare GPIO18 seulement si la carte AD HAT est activée.
ExecStart=/usr/bin/python3 /home/oryx/EtR-core/src/sensor_acquisition_runtime.py --config /etc/etr-core/sensors.json --state /var/lib/etr-core/telemetry.json
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadOnlyPaths=-/etc/etr-core/sensors.json
ReadWritePaths=/var/lib/etr-core
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
