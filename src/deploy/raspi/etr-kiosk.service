[Unit]
Description=EtR kiosk (Chromium on SPI)
Wants=etr-dashboard.service spi-desktop.service etr-wifi-portal.service
After=etr-dashboard.service spi-desktop.service etr-wifi-portal.service
PartOf=spi-desktop.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=oryx
Group=oryx
Environment=HOME=/home/oryx
Environment=DISPLAY=:1
Environment=XAUTHORITY=/home/oryx/.Xauthority
ExecStart=/usr/local/bin/etr-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
